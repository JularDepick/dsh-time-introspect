{
  "name": "dsh-time-introspect",
  "version": "0.1.0",
  "description": "耗时反思插件: 超时后把完整耗时分布以 JSON 注入下一轮, 模型显式开始与结束反思, 并自行控制插件休眠与重启.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README_en-US.md",
    "LICENSE",
    "COPYRIGHT"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "time",
    "introspection",
    "introspect",
    "performance"
  ],
  "license": "Apache-2.0",
  "author": "JularDepick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JularDepick/dsh-time-introspect.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "node scripts/pack.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4",
    "zod": "4.4.3",
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "zod": "4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "homepage": "https://github.com/JularDepick/dsh-time-introspect#readme",
  "bugs": {
    "url": "https://github.com/JularDepick/dsh-time-introspect/issues"
  }
}
